<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The linearizability checker's budget against the soak's hardest decided histories (P5-05), apart
    from Raft.Scale.Tests: a harness entry runs its target's whole project, and these searches take
    minutes and up to 5 GB each, which every scale entry would pay, four workers at once. Only
    S-soak-6 aims here. The soak's settings, workload and checkers are compiled in by link.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Raft.Core.Tests/ClientHistory.cs" Link="Checkers/ClientHistory.cs" />
    <Compile Include="../Raft.Core.Tests/Cluster.cs" Link="Checkers/Cluster.cs" />
    <Compile Include="../Raft.Core.Tests/CommitLiveness.cs" Link="Checkers/CommitLiveness.cs" />
    <Compile Include="../Raft.Core.Tests/ElectionInvariants.cs" Link="Checkers/ElectionInvariants.cs" />
    <Compile Include="../Raft.Core.Tests/LogInvariants.cs" Link="Checkers/LogInvariants.cs" />
    <Compile Include="../Raft.Scale.Tests/RaftWorkload.cs" Link="Soak/RaftWorkload.cs" />
    <Compile Include="../Raft.Scale.Tests/SoakConfig.cs" Link="Soak/SoakConfig.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Raft.Core/Raft.Core.csproj" />
    <ProjectReference Include="../../src/Raft.Simulation/Raft.Simulation.csproj" />
    <ProjectReference Include="../../src/Raft.Kv/Raft.Kv.csproj" />
    <ProjectReference Include="../../src/Raft.Checker/Raft.Checker.csproj" />
    <ProjectReference Include="../../tools/Raft.SimRun/Raft.SimRun.csproj" />
  </ItemGroup>
</Project>
