<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Membership changes in generated executions (P6-07..P6-09), apart from Raft.Scale.Tests: a harness
    entry runs its target's whole project, and this sample's 300 executions of five nodes would cost
    every scale entry minutes. The soak's settings, the checkers, the stable suffix and the soak's
    run itself are compiled in by link: the membership soak (P6-12) is a profile of the same run,
    with its own floors and its own known limits.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Raft.Core.Tests/Agreement.cs" Link="Checkers/Agreement.cs" />
    <Compile Include="../Raft.Core.Tests/ClientHistory.cs" Link="Checkers/ClientHistory.cs" />
    <Compile Include="../Raft.Core.Tests/SessionWorkload.cs" Link="Checkers/SessionWorkload.cs" />
    <Compile Include="../Raft.Core.Tests/CompactionCoverage.cs" Link="Checkers/CompactionCoverage.cs" />
    <Compile Include="../Raft.Core.Tests/SessionCoverage.cs" Link="Checkers/SessionCoverage.cs" />
    <Compile Include="../Raft.Core.Tests/Cluster.cs" Link="Checkers/Cluster.cs" />
    <Compile Include="../Raft.Core.Tests/CommitLiveness.cs" Link="Checkers/CommitLiveness.cs" />
    <Compile Include="../Raft.Core.Tests/ElectionInvariants.cs" Link="Checkers/ElectionInvariants.cs" />
    <Compile Include="../Raft.Core.Tests/LogInvariants.cs" Link="Checkers/LogInvariants.cs" />
    <Compile Include="../Raft.Scale.Tests/SoakConfig.cs" Link="Soak/SoakConfig.cs" />
    <Compile Include="../Raft.Scale.Tests/Stability.cs" Link="Soak/Stability.cs" />
    <Compile Include="../Raft.Scale.Tests/Soak.cs" Link="Soak/Soak.cs" />
    <Compile Include="../Raft.Scale.Tests/KnownLimits.cs" Link="Soak/KnownLimits.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Raft.Core/Raft.Core.csproj" />
    <ProjectReference Include="../../src/Raft.Simulation/Raft.Simulation.csproj" />
    <ProjectReference Include="../../src/Raft.Kv/Raft.Kv.csproj" />
    <ProjectReference Include="../../src/Raft.Checker/Raft.Checker.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Both soaks' known limits (KnownLimits is shared): the membership soak reads its own, and its test checks it is not the baseline's. -->
    <None Include="../../ci/known-limits.txt" Link="known-limits.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../ci/known-limits-membership.txt" Link="known-limits-membership.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
