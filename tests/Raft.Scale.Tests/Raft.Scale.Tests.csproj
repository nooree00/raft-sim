<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The Raft cluster in the simulator at scale (P4-11): the soak sample, durability, disruption,
    positive controls, replication and election simulations, shrinking. Split from Raft.Core.Tests
    so that a harness entry aimed at a unit test does not run these. The checkers are proven on
    hand-built traces in Raft.Core.Tests and compiled in here by link.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Raft.Core.Tests/Agreement.cs" Link="Checkers/Agreement.cs" />
    <Compile Include="../Raft.Core.Tests/CompactionCoverage.cs" Link="Checkers/CompactionCoverage.cs" />
    <Compile Include="../Raft.Core.Tests/ClientHistory.cs" Link="Checkers/ClientHistory.cs" />
    <Compile Include="../Raft.Core.Tests/Cluster.cs" Link="Checkers/Cluster.cs" />
    <Compile Include="../Raft.Core.Tests/CommitLiveness.cs" Link="Checkers/CommitLiveness.cs" />
    <Compile Include="../Raft.Core.Tests/ElectionInvariants.cs" Link="Checkers/ElectionInvariants.cs" />
    <Compile Include="../Raft.Core.Tests/LogInvariants.cs" Link="Checkers/LogInvariants.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Raft.Core/Raft.Core.csproj" />
    <ProjectReference Include="../../src/Raft.Simulation/Raft.Simulation.csproj" />
    <ProjectReference Include="../../src/Raft.Kv/Raft.Kv.csproj" />
    <ProjectReference Include="../../src/Raft.Checker/Raft.Checker.csproj" />
    <ProjectReference Include="../../tools/Raft.SimRun/Raft.SimRun.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- P5-05: the recorded known limits, read by the soak; `gates register` reads the same file. -->
    <None Include="../../ci/known-limits.txt" Link="known-limits.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- P6-12: the membership soak's own known limits, named by KnownLimitTests beside the baseline's. -->
    <None Include="../../ci/known-limits-membership.txt" Link="known-limits-membership.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
